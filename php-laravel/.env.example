# ---------------------------------------------------------------------------
# php-laravel benchmark backend — environment reference.
#
# The benchmark harness (docker compose) injects only the contract variables;
# everything else is provided by image defaults or generated at boot.
# ---------------------------------------------------------------------------

# Contract: TCP port the container-internal nginx serves HTTP on. The edge
# nginx proxies to the php service on this port. Default: 9000.
PORT=9000

# Contract: Postgres connection string. Parsed at boot by
# app/Providers/AppServiceProvider.php into the pgsql connection config.
# Default: postgres://app:app@db:5432/app
DATABASE_URL=postgres://app:app@db:5432/app

# Contract: max connections per process context. For this stack it is
# informational: PHP-FPM runs pm=static pm.max_children=10 and each worker
# keeps one persistent PDO connection, bounding the container's pool at 10.
POOL_SIZE=10

# ---------------------------------------------------------------------------
# Laravel runtime settings (image defaults; see Dockerfile ENV). No .env file
# ships with the container — create-project generates one per build, but the
# container environment always takes precedence.
# ---------------------------------------------------------------------------

# NOTE: Laravel's per-component DB_* variables (DB_CONNECTION, DB_HOST,
# DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD) are IGNORED by this backend:
# the pgsql connection is configured entirely from DATABASE_URL at boot.

APP_ENV=production
APP_DEBUG=false
# Generated on first boot if unset (entrypoint.sh): base64:<32 random bytes>
APP_KEY=
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr