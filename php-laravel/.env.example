# ---------------------------------------------------------------------------
# php-laravel benchmark backend — environment reference.
#
# The benchmark harness (docker compose) injects only the contract variables;
# everything else is provided by the image via the compose service ENV.
# ---------------------------------------------------------------------------

# Contract: TCP port FrankenPHP serves HTTP on (Traefik proxies to it). NOTE:
# the inline Caddyfile in docker-compose.yml hardcodes :9000 — keep PORT=9000
# unless the Caddyfile is regenerated from POOL_SIZE first. Default: 9000.
PORT=9000

# Contract: Postgres connection string. Parsed at boot by
# app/Providers/AppServiceProvider.php into the pgsql connection config.
# Default: postgres://app:app@db:5432/app
DATABASE_URL=postgres://app:app@db:5432/app

# Contract: max connections per process. FrankenPHP's Caddyfile pins
# num_threads to this value (10 by default; see docker-compose.yml) and each
# thread keeps one persistent PDO connection (PDO::ATTR_PERSISTENT), bounding
# the container's Postgres pool at 10 in steady state.
POOL_SIZE=10

# ---------------------------------------------------------------------------
# Laravel runtime settings (compose ENV always takes precedence over .env).
# ---------------------------------------------------------------------------

# NOTE: Laravel's per-component DB_* variables (DB_CONNECTION, DB_HOST,
# DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD) are IGNORED by this backend:
# the pgsql connection is configured entirely from DATABASE_URL at boot.

APP_ENV=production
APP_DEBUG=false
# Fixed dev-only key (32 bytes, base64) — identical to the compose service ENV.
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr