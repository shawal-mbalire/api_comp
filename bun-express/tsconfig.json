{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // We run .ts directly (Node 24+ type stripping / Bun native TS) so there is
    // no emit step — tsc is a type-checker only. Relative imports carry the
    // explicit .ts extension (required by the runtimes).
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    // Strong types: no implicit any, no unchecked access, type-only imports
    // kept explicit for the runtime type strippers.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}