set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory()

default:
    @just --list

install:
    @npm install

# Strict typecheck only — no emit (Node 24+ strips types at runtime).
typecheck:
    @npx tsc --noEmit

# node --test unit tests (fake repository) — no DB.
test:
    @node --test tests/

start:
    @node main.ts